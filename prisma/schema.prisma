generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int           @id @default(autoincrement())
  clerkUserId       String?       @unique
  ucid              String?
  schoolEmail       String?       @unique
  phoneNumber       String?
  firstName         String?
  lastName          String?
  fieldOfStudy      String?
  schoolYear        String?
  yearJoined        DateTime?     @db.Date
  yearRetired       DateTime?     @db.Date
  company           String?
  companyTitle      String?
  profilePictureUrl String?
  description       String?
  linkedIn          String?
  teamRole          String?
  role              TeamRole?     @relation(fields: [teamRole], references: [name], onDelete: Restrict, onUpdate: Cascade)
  updatedAt         DateTime      @default("1970-01-01T00:00:00Z") @updatedAt
  modifiedBy        String        @default("SYSTEM")
  deletedAt         DateTime?
}

model Timeline {
  id          Int       @id @default(autoincrement())
  year        Int
  monthNum    Int
  monthName   String
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default("1970-01-01T00:00:00Z") @updatedAt
  modifiedBy  String    @default("SYSTEM")
  deletedAt   DateTime?

  @@unique([year, monthNum])
}

model Sponsor {
  id           Int          @id @default(autoincrement())
  name         String
  logoUrl      String
  websiteUrl   String
  description  String?
  sponsorLevel SponsorLevel
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default("1970-01-01T00:00:00Z") @updatedAt
  modifiedBy   String       @default("SYSTEM")
  deletedAt    DateTime?
}

model Recruitment {
  id          Int       @id @default(autoincrement())
  header      String
  description String
  link        String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default("1970-01-01T00:00:00Z") @updatedAt
  modifiedBy  String    @default("SYSTEM")
  deletedAt   DateTime?
}

enum SponsorLevel {
  Gold    @map("Gold")
  Silver  @map("Silver")
  Bronze  @map("Bronze")
  Friends @map("Friends")
}

model TeamRole {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  section    String
  adminOnly  Boolean  @default(false)
  sortOrder  Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt
  modifiedBy String   @default("SYSTEM")
  users      User[]
}
