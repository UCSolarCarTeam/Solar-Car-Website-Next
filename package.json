{
  "name": "solar-car-website-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "cross-env ANALYZE=true next build",
    "build": "prisma generate && tsc --noEmit && next build",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; for (const dir of ['.next', 'out']) { fs.rmSync(dir, { recursive: true, force: true }); }\"",
    "biome:fix": "biome check --write .",
    "db:generate": "prisma generate",
    "db:migrate:reset": "prisma migrate reset && prisma generate && prisma db seed",
    "db:migrate:dev": "prisma migrate dev && prisma generate",
    "db:migrate:prod": "prisma migrate deploy",
    "db:pull": "prisma db pull && prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.5",
    "@flags-sdk/vercel": "1.3.0",
    "@prisma/client": "^6.4.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.45.4",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.50.0",
    "@tanstack/react-table": "^8.20.5",
    "@trpc/client": "^11.0.0-rc.446",
    "@trpc/next": "^11.0.0-rc.446",
    "@trpc/react-query": "^11.0.0-rc.446",
    "@trpc/server": "^11.0.0-rc.446",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "detect-gpu": "^5.0.70",
    "flags": "4.0.6",
    "framer-motion": "^12.23.22",
    "geist": "^1.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "postcss": "^8.5.16",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.7.0",
    "react-select": "^5.8.1",
    "react-spinners": "^0.15.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "superjson": "^2.2.1",
    "svix": "^1.37.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@faker-js/faker": "^8.0.2",
    "@next/bundle-analyzer": "^16.2.10",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "prisma": "^6.4.1",
    "shadcn": "^4.13.0",
    "tsx": "^4.22.0",
    "typescript": "7.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "yarn@1.22.22"
}
